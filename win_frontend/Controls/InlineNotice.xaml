<UserControl x:Class="SuzuEmojy.Windows.Controls.InlineNotice"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsHitTestVisible="False" Visibility="Collapsed"
             AutomationProperties.LiveSetting="Polite">
  <Border x:Name="NoticeCard" Background="{DynamicResource NoticeSurface}" BorderBrush="{DynamicResource Divider}"
          BorderThickness="1" CornerRadius="8" Padding="12,10">
    <DockPanel>
      <TextBlock x:Name="Symbol" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,0,10,0"
                 FontWeight="SemiBold" Text="✓" Foreground="{DynamicResource Ink}"/>
      <StackPanel>
        <TextBlock x:Name="Heading" Foreground="{DynamicResource Ink}" FontWeight="SemiBold"/>
        <TextBlock x:Name="Detail" Foreground="{DynamicResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"/>
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>
