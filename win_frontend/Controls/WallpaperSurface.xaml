<UserControl x:Class="SuzuEmojy.Windows.Controls.WallpaperSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" IsHitTestVisible="False" Focusable="False">
  <Grid ClipToBounds="True">
    <Border x:Name="Texture" RenderOptions.BitmapScalingMode="HighQuality"/>
    <Border x:Name="BrightnessVeil" Visibility="Collapsed"/>
    <Border x:Name="Overlay" Background="{DynamicResource CanvasColor}" Visibility="Collapsed"/>
  </Grid>
</UserControl>
