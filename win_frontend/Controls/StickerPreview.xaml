<UserControl x:Class="SuzuEmojy.Windows.Controls.StickerPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsHitTestVisible="False" UseLayoutRounding="True">
  <Border Background="{DynamicResource PreviewSurface}" BorderBrush="{DynamicResource PreviewEdge}"
          BorderThickness="1" CornerRadius="8" Padding="7">
    <StackPanel>
      <Image x:Name="Picture" Stretch="Uniform" Margin="0,0,0,4"/>
      <TextBlock x:Name="Categories" FontSize="12" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="Keywords" FontSize="12" Foreground="{DynamicResource Ink}" TextTrimming="CharacterEllipsis"
                 Margin="0,2,0,0"/>
    </StackPanel>
  </Border>
</UserControl>
