<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="FluentField" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
    <Setter Property="Background" Value="{DynamicResource FieldSurface}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Padding" Value="11,0"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Frame" CornerRadius="5" Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource SettingCardEdge}" BorderThickness="1">
            <Grid>
              <Border x:Name="Underline" Height="1" VerticalAlignment="Bottom" CornerRadius="0,0,4,4"
                      Background="{DynamicResource SearchUnderline}" IsHitTestVisible="False"/>
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Focusable="False"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Underline" Property="Height" Value="2"/>
              <Setter TargetName="Underline" Property="Background" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="Tag" Value="True">
              <Setter TargetName="Underline" Property="Background" Value="{DynamicResource NoticeWarning}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FluentPasswordField" TargetType="PasswordBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
    <Setter Property="Background" Value="{DynamicResource FieldSurface}"/>
    <Setter Property="Padding" Value="11,0"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border CornerRadius="5" Background="{TemplateBinding Background}"
                  BorderBrush="{DynamicResource SettingCardEdge}" BorderThickness="1">
            <Grid>
              <Border x:Name="Underline" Height="1" VerticalAlignment="Bottom" CornerRadius="0,0,4,4"
                      Background="{DynamicResource SearchUnderline}" IsHitTestVisible="False"/>
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Underline" Property="Height" Value="2"/>
              <Setter TargetName="Underline" Property="Background" Value="{DynamicResource Accent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FluentPushButton" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource FieldSurface}"/>
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource SettingCardEdge}"
                  BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
            <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.65"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FluentPrimaryButton" TargetType="Button" BasedOn="{StaticResource FluentPushButton}">
    <Setter Property="Background" Value="{DynamicResource Accent}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
  </Style>
  <Style x:Key="FluentCheckBox" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <DockPanel Background="Transparent">
            <Border x:Name="Box" DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Center"
                    Background="{DynamicResource FieldSurface}" BorderBrush="{DynamicResource ToggleRail}"
                    BorderThickness="1" CornerRadius="4" Margin="0,0,8,0">
              <Path x:Name="Tick" Data="M1,5 L4,8 10,2" Stroke="{DynamicResource OnAccent}" StrokeThickness="1.5"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Opacity" Value="0.75"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FluentRadioButton" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <DockPanel Background="Transparent">
            <Grid DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0">
              <Ellipse x:Name="Ring" Fill="{DynamicResource FieldSurface}" Stroke="{DynamicResource ToggleRail}"/>
              <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
            </Grid>
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Ink}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FluentChoiceButton" TargetType="Button" BasedOn="{StaticResource FluentPushButton}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ContentPresenter Content="{Binding}" VerticalAlignment="Center"/>
            <Path Grid.Column="1" Data="M0,0 L4,4 8,0" Stroke="{DynamicResource Ink}" StrokeThickness="1"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  VerticalAlignment="Center" Margin="8,0,0,0"/>
          </Grid>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FluentSwitch" TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <TextBlock x:Name="State" Text="Off" Width="30" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
            <Border x:Name="Rail" Width="41" Height="21" CornerRadius="11" VerticalAlignment="Center"
                    BorderThickness="1" BorderBrush="{DynamicResource ToggleRail}" Background="Transparent">
              <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource Hint}" Margin="4,0"
                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="State" Property="Text" Value="On"/>
              <Setter TargetName="Rail" Property="Background" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Rail" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccent}"/>
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Rail" Property="Opacity" Value="0.8"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FluentRailButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent">
            <Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="{TemplateBinding Background}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FluentSlider" TargetType="Slider">
    <Setter Property="Height" Value="30"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid>
          <Border Height="4" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource SliderRail}"/>
          <Track x:Name="PART_Track">
            <Track.DecreaseRepeatButton>
              <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource FluentRailButton}" Background="{DynamicResource Accent}"/>
            </Track.DecreaseRepeatButton>
            <Track.IncreaseRepeatButton>
              <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource FluentRailButton}" Background="Transparent"/>
            </Track.IncreaseRepeatButton>
            <Track.Thumb>
              <Thumb Width="20" Height="20">
                <Thumb.Template>
                  <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="10" Background="{DynamicResource SliderThumb}"
                            BorderBrush="{DynamicResource SettingCardEdge}" BorderThickness="1">
                      <Ellipse Width="10" Height="10" Fill="{DynamicResource Accent}"/>
                    </Border>
                  </ControlTemplate>
                </Thumb.Template>
              </Thumb>
            </Track.Thumb>
          </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
