<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(UseSystemWindowsRuntime)' != 'true'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(UseSystemWindowsRuntime)' == 'true'">net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <Version>2.0.0-preview</Version>
    <ApplicationIcon>../ico.ico</ApplicationIcon>
    <BaseOutputPath>../dist/win-frontend/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../ico.ico" Link="ico.ico" />
    <InternalsVisibleTo Include="SuzuEmojy.Windows.Tests" />
  </ItemGroup>
  <PropertyGroup Condition="'$(UseSystemWindowsRuntime)' == 'true'">
    <PlatformTarget>x64</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseSystemWindowsRuntime)' == 'true'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <PackageReference Include="Microsoft.Bcl.TimeProvider" Version="8.0.1" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>
  <Target Name="CopySystemRuntimeNotices" AfterTargets="Publish" Condition="'$(UseSystemWindowsRuntime)' == 'true'">
    <ItemGroup>
      <AppLocalPackage Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' != ''">
        <PackageRoot>$([MSBuild]::GetDirectoryNameOfFileAbove('%(ReferenceCopyLocalPaths.RelativeDir)', '%(ReferenceCopyLocalPaths.NuGetPackageId).nuspec'))</PackageRoot>
      </AppLocalPackage>
      <AppLocalNotice Include="%(AppLocalPackage.PackageRoot)/LICENSE.TXT;%(AppLocalPackage.PackageRoot)/THIRD-PARTY-NOTICES.TXT"
                      Condition="'%(AppLocalPackage.PackageRoot)' != ''">
        <PackageId>%(AppLocalPackage.NuGetPackageId)</PackageId>
      </AppLocalNotice>
      <_ExistingNotice Include="@(AppLocalNotice)" Condition="Exists('%(AppLocalNotice.FullPath)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_ExistingNotice)" DestinationFiles="@(_ExistingNotice->'$(PublishDir)licenses/%(PackageId)/%(Filename)%(Extension)')" />
  </Target>
</Project>
