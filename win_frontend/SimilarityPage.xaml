<UserControl x:Class="SuzuEmojy.Windows.SimilarityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource Ink}" UseLayoutRounding="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls/FluentFields.xaml"/>
        <ResourceDictionary Source="Controls/FluentScroll.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Margin="36,0,30,14">
    <Grid x:Name="Overview">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="结果为疑似相似图片，请逐张比较后勾选删除。动图悬停播放，点击图片放大；预览中方向键跨组切换，Del 切换删除勾选。"
                   TextWrapping="Wrap" Margin="0,0,0,9" Foreground="{DynamicResource Hint}"/>
        <WrapPanel x:Name="Options">
          <Button x:Name="Scan" Content="开始扫描" Style="{StaticResource FluentPrimaryButton}" MinWidth="84" Margin="0,0,6,5"/>
          <Button x:Name="CancelScan" Content="取消" Style="{StaticResource FluentPushButton}" MinWidth="64" Margin="0,0,0,5"/>
        </WrapPanel>
        <Grid Margin="0,3,0,4">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
          <TextBlock Text="严格" VerticalAlignment="Center"/>
          <Slider x:Name="Threshold" Grid.Column="1" Minimum="0" Maximum="16" Value="6" TickFrequency="1"
                  IsSnapToTickEnabled="True" SmallChange="1" LargeChange="2" Margin="9,0"
                  Style="{StaticResource FluentSlider}" AutomationProperties.Name="匹配阈值"/>
          <TextBlock Grid.Column="2" Text="宽松" VerticalAlignment="Center"/>
          <TextBlock x:Name="ThresholdValue" Grid.Column="3" Text="6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <TextBlock x:Name="Status" Text="选择范围后点击开始扫描。" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" Margin="0,2,0,6"/>
        <ProgressBar x:Name="Progress" Height="3" Visibility="Collapsed" Foreground="{DynamicResource Accent}" Margin="0,0,0,5"/>
      </StackPanel>
      <Border Grid.Row="1" Background="{DynamicResource SettingCardSurface}" BorderBrush="{DynamicResource SettingCardEdge}"
              BorderThickness="1" CornerRadius="8" Padding="10,4,4,4">
        <ScrollViewer x:Name="ResultScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Template="{StaticResource FluentScrollTemplate}">
          <StackPanel x:Name="Results" Margin="0,6,6,6"/>
        </ScrollViewer>
      </Border>
      <WrapPanel Grid.Row="2" Margin="0,8,0,0">
        <Button x:Name="PreviousPage" Content="上一页" Style="{StaticResource FluentPushButton}" Margin="0,0,6,4"/>
        <TextBlock x:Name="PageNumber" Margin="2,0,8,4" VerticalAlignment="Center" Foreground="{DynamicResource Hint}"/>
        <Button x:Name="NextPage" Content="下一页" Style="{StaticResource FluentPushButton}" Margin="0,0,12,4"/>
        <Button x:Name="ClearSelection" Content="清空选择" Style="{StaticResource FluentPushButton}" Margin="0,0,6,4"/>
        <Button x:Name="DeleteSelection" Style="{StaticResource FluentPushButton}" Margin="0,0,0,4"/>
      </WrapPanel>
      <Border x:Name="DeleteConfirmation" Grid.Row="3" Background="{DynamicResource NoticeSurface}"
              BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="8"
              Visibility="Collapsed" Padding="12,8" Margin="0,4,0,0">
        <StackPanel>
          <TextBlock Text="确认删除" FontWeight="SemiBold"/>
          <TextBlock x:Name="DeleteWarning" TextWrapping="Wrap" Foreground="{DynamicResource Hint}" Margin="0,4,0,8"/>
          <WrapPanel>
            <Button x:Name="CancelDelete" Content="取消" Style="{StaticResource FluentPushButton}" Margin="0,0,6,0"/>
            <Button x:Name="ConfirmDelete" Content="确认删除" Style="{StaticResource FluentPushButton}"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
    <Grid x:Name="Inspector" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Border Background="{DynamicResource SettingCardSurface}" BorderBrush="{DynamicResource SettingCardEdge}"
              BorderThickness="1" CornerRadius="8" Padding="8" ClipToBounds="True">
        <Grid>
          <Image x:Name="LargePicture" Stretch="Uniform" MaxWidth="680" MaxHeight="500"/>
          <TextBlock x:Name="MissingLarge" Text="无法预览" VerticalAlignment="Center" HorizontalAlignment="Center"
                     Foreground="{DynamicResource Hint}" Visibility="Collapsed"/>
        </Grid>
      </Border>
      <TextBlock x:Name="PictureDetails" Grid.Row="1" TextWrapping="Wrap" Margin="0,8,0,6"/>
      <WrapPanel Grid.Row="2">
        <Button x:Name="PreviousPicture" Content="上一张" Style="{StaticResource FluentPushButton}" Margin="0,0,6,4"/>
        <Button x:Name="NextPicture" Content="下一张" Style="{StaticResource FluentPushButton}" Margin="0,0,12,4"/>
        <CheckBox x:Name="MarkPicture" Content="选择删除 (Del)" Style="{StaticResource FluentCheckBox}" VerticalAlignment="Center"/>
      </WrapPanel>
      <TextBlock Grid.Row="3" Text="← / ↑ 上一张，→ / ↓ 下一张；跨组浏览，Del 切换删除勾选。"
                 Foreground="{DynamicResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0"/>
    </Grid>
  </Grid>
</UserControl>
