<UserControl x:Class="SuzuEmojy.Windows.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="clr-namespace:SuzuEmojy.Windows.Controls"
             Focusable="False" UseLayoutRounding="True">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Controls/FluentFields.xaml"/>
        <ResourceDictionary Source="Controls/FluentScroll.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Template="{StaticResource FluentScrollTemplate}">
    <StackPanel Margin="36,0,30,20">
      <TextBlock Text="SuzuEmojy" Foreground="{DynamicResource Ink}" FontSize="22"/>
      <TextBlock x:Name="VersionText" Foreground="{DynamicResource Hint}" Margin="0,4,0,14"/>
      <WrapPanel>
        <Button x:Name="OpenProject" Content="项目主页" Style="{StaticResource FluentPushButton}" Margin="0,0,8,8"/>
        <Button x:Name="CheckUpdate" Content="检查更新" Style="{StaticResource FluentPushButton}" Margin="0,0,8,8"/>
        <Button x:Name="DownloadUpdate" Content="下载更新…" Style="{StaticResource FluentPushButton}" Margin="0,0,8,8" Visibility="Collapsed"/>
        <Button x:Name="OpenReleases" Content="打开发布页" Style="{StaticResource FluentPushButton}" Margin="0,0,0,8"/>
      </WrapPanel>
      <fluent:InlineNotice x:Name="Status"/>
      <fluent:OperationProgress x:Name="DownloadProgress"/>
      <TextBlock x:Name="Notes" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource Ink}"/>
      <TextBlock Text="关于作者与个人介绍" FontSize="20" Margin="0,20,0,10" Foreground="{DynamicResource Ink}"/>
      <TextBlock Text="IxinorTyan" FontSize="16" Foreground="{DynamicResource Ink}"/>
      <WrapPanel Margin="0,8,0,0">
        <Button x:Name="OpenAuthor" Content="作者主页" Style="{StaticResource FluentPushButton}" Margin="0,0,8,8"/>
        <Button x:Name="CopyGroup" Content="QQ 交流群：834586488" ToolTip="点击复制 QQ 群号"
                Style="{StaticResource FluentPushButton}" Margin="0,0,0,8"/>
      </WrapPanel>
      <TextBlock Text="致谢与鸣谢" FontSize="20" Margin="0,20,0,10" Foreground="{DynamicResource Ink}"/>
      <StackPanel x:Name="Credits"/>
      <TextBlock Text="开源协议与声明" FontSize="20" Margin="0,20,0,10" Foreground="{DynamicResource Ink}"/>
      <Button x:Name="OpenLicense" Content="GNU General Public License v3.0 (GPL-3.0)"
              Style="{StaticResource FluentPushButton}" HorizontalAlignment="Left"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
