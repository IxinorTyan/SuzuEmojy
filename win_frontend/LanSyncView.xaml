<UserControl x:Class="SuzuEmojy.Windows.LanSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <StackPanel x:Name="Pairing" Visibility="Collapsed">
      <Image x:Name="Qr" Width="216" Height="216" Margin="0,4,0,10"
             RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="配对二维码"/>
      <TextBox x:Name="Addresses" IsReadOnly="True" BorderThickness="0" Background="Transparent"
               Foreground="{DynamicResource Ink}" TextAlignment="Center" TextWrapping="Wrap"
               AutomationProperties.Name="电脑地址"/>
    </StackPanel>
    <TextBlock x:Name="Code" FontSize="21" FontWeight="SemiBold" TextAlignment="Center" Margin="0,6"
               Foreground="{DynamicResource Ink}" Visibility="Collapsed"/>
    <TextBlock x:Name="Status" Text="正在开启连接…" TextWrapping="Wrap" Foreground="{DynamicResource Ink}"
               Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
</UserControl>
