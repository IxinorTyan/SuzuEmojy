<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(UseSystemWindowsRuntime)' != 'true'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(UseSystemWindowsRuntime)' == 'true'">net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <BaseOutputPath>../dist/win-refurbisher/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../win_frontend/SuzuEmojy.Windows.csproj" />
  </ItemGroup>
</Project>
