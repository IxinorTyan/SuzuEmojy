<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(UseSystemWindowsRuntime)' != 'true'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(UseSystemWindowsRuntime)' == 'true'">net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <BaseOutputPath>../dist/win-frontend-tests/</BaseOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseSystemWindowsRuntime)' == 'true'">
    <PlatformTarget>x64</PlatformTarget>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../win_frontend/SuzuEmojy.Windows.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseSystemWindowsRuntime)' == 'true'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
